generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Manager {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  password_hash String
  email         String   @unique
  created_at    DateTime @default(now())
}

model Employee {
  id            Int       @id @default(autoincrement())
  first_name    String
  last_name     String
  email         String    @unique
  position      String
  hire_date     DateTime
  leave_balance Decimal   @default(18)
  is_active     Boolean   @default(true)
  absences      Absence[]
}

model AbsenceType {
  id             Int       @id @default(autoincrement())
  name           String
  color          String    @default("#3B82F6")
  deduct_balance Boolean   @default(false)
  is_active      Boolean   @default(true)
  absences       Absence[]
}

model Absence {
  id          Int         @id @default(autoincrement())
  employee    Employee    @relation(fields: [employee_id], references: [id])
  employee_id Int
  type        AbsenceType @relation(fields: [type_id], references: [id])
  type_id     Int
  start_date  DateTime
  end_date    DateTime
  is_half_day Boolean     @default(false)
  reason      String?
  created_at  DateTime    @default(now())
}